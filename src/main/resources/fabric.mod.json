{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${version}",
  "name": "${modName}",
  "description": "${description}",
  "authors": ["@authors@"],
  "contact": {},
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.cozystudios.tokimiboatyard.loaders.fabric.FabricEntrypoint"
    ],
    "client": [
      "net.cozystudios.tokimiboatyard.TokimiBoatyardClient"
    ],
    "jei_mod_plugin": [
      "net.cozystudios.tokimiboatyard.compat.jei.TokimiJeiPlugin"
    ]
  },
  "recommends": {
    "jei": "*"
  },
  "mixins": [
    "tokimiboatyard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.10",
    "minecraft": "${minecraft_version}",
    "java": "${java_version}",
    "fabric-api": "*"
  }
}
